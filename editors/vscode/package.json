{
  "name": "z33-assembly",
  "displayName": "Zorglub33",
  "description": "Zorglub33 (Z33) assembly language support",
  "version": "0.8.5",
  "publisher": "quentin-gliech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandhose/z33-emulator"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "browser": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onDebugResolve:zorglub33",
    "onDebugDynamicConfigurations:zorglub33"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zorglub33.runFile",
        "title": "Run Current File",
        "category": "Zorglub33",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "zorglub33.runFile",
          "when": "resourceLangId == zorglub33-assembly",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "zorglub33.runFile",
          "when": "resourceLangId == zorglub33-assembly"
        }
      ]
    },
    "languages": [
      {
        "id": "zorglub33-assembly",
        "aliases": [
          "Zorglub33 Assembly",
          "zorglub33"
        ],
        "extensions": [
          ".s",
          ".S"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zorglub33-assembly",
        "scopeName": "source.zorglub33",
        "path": "./syntaxes/zorglub33.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "zorglub33-assembly"
      }
    ],
    "debuggers": [
      {
        "type": "zorglub33",
        "label": "Zorglub33 Debug",
        "languages": [
          "zorglub33-assembly"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Zorglub33 assembly entry file to debug.",
                "default": "${file}"
              },
              "entrypoint": {
                "type": "string",
                "description": "Label the program counter starts at.",
                "default": "main"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop at the entrypoint after launch.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zorglub33",
            "request": "launch",
            "name": "Debug Zorglub33 program",
            "program": "${file}",
            "entrypoint": "main",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Zorglub33: Launch program",
            "description": "Debug a Zorglub33 assembly program",
            "body": {
              "type": "zorglub33",
              "request": "launch",
              "name": "Debug Zorglub33 program",
              "program": "^\"\\${file}\"",
              "entrypoint": "main",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Zorglub33",
      "properties": {
        "zorglub33-assembly.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Zorglub33 language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build:bundle": "node build.mjs --production",
    "build": "pnpm --filter z33-editor-shared run build:wasm && pnpm run build:bundle",
    "watch": "node build.mjs --watch",
    "check": "node -e \"try{require.resolve('z33-editor-shared/wasm')}catch{process.exit(1)}\" || pnpm --filter z33-editor-shared run build:wasm && tsc --noEmit && pnpm run lint && oxfmt --check src/ e2e/ playwright.config.ts",
    "lint": "oxlint src/ e2e/ playwright.config.ts",
    "fmt": "oxfmt src/ e2e/ playwright.config.ts",
    "package": "vsce package --no-dependencies",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/vscode": "~1.100.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "ovsx": "^1.1.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "z33-editor-shared": "workspace:*"
  }
}
