      "name": "workspaceFolder spelling",
      "program": "${workspaceFolder}/fact.s",
      "entrypoint": "main",
      "stopOnEntry": true
    },
    {
      "type": "zorglub33",
      "request": "launch",
      "name": "relative spelling",
