{
  "name": "z33-web",
  "private": true,
  "type": "module",
  "imports": {
    "#*": ["./*", "./*.ts", "./*.tsx"]
  },
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/wasm --target web --out-dir ../../editors/web/pkg --out-name z33_web",
    "build:wasm:dev": "wasm-pack build ../../crates/wasm --dev --target web --out-dir ../../editors/web/pkg --out-name z33_web",
    "build": "pnpm run build:wasm && vite build",
    "start": "pnpm run build:wasm:dev && vite",
    "check": "oxlint app/ e2e/ scripts/ && oxfmt --check app/ e2e/ scripts/",
    "lint": "oxlint app/ e2e/ scripts/",
    "lint:fix": "oxlint --fix app/ e2e/ scripts/",
    "fmt": "oxfmt app/ e2e/ scripts/",
    "fmt:check": "oxfmt --check app/ e2e/ scripts/",
    "knip": "knip",
    "check:chunks": "node scripts/check-chunks.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest run --project=storybook",
    "test-storybook:watch": "vitest --project=storybook"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^4.1.11",
    "knip": "^6.34.0",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "shadcn": "^4.20.0",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wasm-pack": "catalog:"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "monaco-editor": "^0.56.0",
    "monaco-languageserver-types": "~0.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "zustand": "^5.0.15"
  }
}
